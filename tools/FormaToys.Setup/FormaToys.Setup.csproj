<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FormaToys.Setup</RootNamespace>
    <AssemblyName>FormaToys-Setup</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <Nullable>enable</Nullable>
    <ApplicationIcon>..\..\src\FormaToys.App\Assets\app.ico</ApplicationIcon>
    <Copyright>Copyright (C) 2026 FormaToys</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <!--  由 tools\package-release.ps1 在构建前放入打包好的 payload.zip  -->
    <EmbeddedResource Include="Assets\payload.zip" LogicalName="FormaToys.Setup.payload.zip" Condition="Exists('Assets\payload.zip')" />
  </ItemGroup>

</Project>
