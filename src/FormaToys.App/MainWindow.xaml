<Window
    x:Class="FormaToys.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="16,0,152,0">
            <StackPanel
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="10">
                <Border
                    Width="18"
                    Height="18"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    CornerRadius="4">
                    <FontIcon
                        FontSize="10"
                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                        Glyph="&#xE8B5;" />
                </Border>
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="13"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Text="FormaToys" />
            </StackPanel>
        </Grid>

        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            AlwaysShowHeader="False"
            Background="Transparent"
            CompactModeThresholdWidth="0"
            CompactPaneLength="48"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            IsTitleBarAutoPaddingEnabled="False"
            OpenPaneLength="200"
            PaneDisplayMode="Left"
            SelectionChanged="OnNavSelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Name="ConvertNavItem"
                    AutomationProperties.Name="转换"
                    Content="转换"
                    Tag="convert">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B5;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem
                    x:Name="SettingsNavItem"
                    AutomationProperties.Name="设置"
                    Content="设置"
                    Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="AboutNavItem"
                    AutomationProperties.Name="关于"
                    Content="关于"
                    Tag="about">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Frame x:Name="ContentFrame" IsNavigationStackEnabled="False" />
        </NavigationView>
    </Grid>
</Window>
