<Page
    x:Class="FormaToys.App.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <ScrollViewer>
        <Grid Padding="24,24,24,24" RowSpacing="12">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Margin="0"
                Style="{ThemeResource TitleTextBlockStyle}"
                Text="关于" />

            <Border
                Grid.Row="1"
                Style="{StaticResource CardBorderStyle}">
                <Grid Padding="16" ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="48"
                        Height="48"
                        VerticalAlignment="Top"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        CornerRadius="12">
                        <FontIcon
                            FontSize="22"
                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                            Glyph="&#xE8B5;" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="FormaToys" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="{x:Bind VersionText}" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Text="一个格式转换工具箱。"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Text="本项目代码由 AI 生成，可能存在缺陷，使用前请自行评估。"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border
                Grid.Row="2"
                Style="{StaticResource CardBorderStyle}">
                <StackPanel Padding="16" Spacing="8">
                    <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="开源与许可证" />
                    <TextBlock Text="本程序以 GNU General Public License v3.0 发布。" TextWrapping="Wrap" />
                    <HyperlinkButton
                        Padding="0,4,0,0"
                        Click="OnOpenLicensesClick"
                        Content="查看许可证" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
