<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>FormaToys.App</RootNamespace>
    <AssemblyName>FormaToys</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <UseWinUI>true</UseWinUI>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>false</SelfContained>
    <EnableMsixTooling>false</EnableMsixTooling>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <EnableDefaultContentItems>true</EnableDefaultContentItems>
    <Copyright>Copyright (C) 2026 FormaToys</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.251106002" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FormaToys.Core\FormaToys.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--  ffmpeg 本体以嵌入资源形式随 FormaToys.Core.dll 分发，这里只带许可证全文。  -->
    <Content Include="..\..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    未打包（WindowsPackageType=None）的 WinUI 应用在 dotnet publish 时不会自动把
    <AssemblyName>.pri 带到发布目录，资源里只有 XAML 的 .xbf 与图片目录，
    缺了它启动就会抛 “Cannot locate resource from 'ms-appx:///MainWindow.xaml'”。
    这里显式补一刀。
  -->
  <Target Name="IncludePriInPublish" AfterTargets="Publish">
    <Copy
      SourceFiles="$(TargetDir)$(AssemblyName).pri"
      DestinationFolder="$(PublishDir)"
      SkipUnchangedFiles="true"
      Condition="Exists('$(TargetDir)$(AssemblyName).pri')" />
  </Target>

</Project>
